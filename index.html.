<script>
const checks=document.getElementById('checks'), progress=document.getElementById('progress');
for(let i=1;i<=12;i++){const label=document.createElement('label');label.style.display='block';label.style.padding='4px 0';label.style.color='#a8b5c6';label.innerHTML=`<input type="checkbox" data-lesson="${i}"> Aula ${i}`;checks.appendChild(label)}
function update(){const all=[...checks.querySelectorAll('input')],done=all.filter(x=>x.checked).length;progress.textContent=`${done} de 12 aulas concluídas`;all.forEach(x=>x.parentElement.style.color=x.checked='#35d07f'?'#35d07f':'#a8b5c6')}
checks.addEventListener('change',update);
function resetProgress(){checks.querySelectorAll('input').forEach(x=>x.checked=false);update()}
update();
</script>
